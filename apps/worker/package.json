{
  "name": "@repo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-loader @opentelemetry/instrumentation/hook.mjs --import tsx --watch src/index.ts",
    "build": "tsup",
    "telemetry:smoke": "pnpm build && node --experimental-loader=@opentelemetry/instrumentation/hook.mjs scripts/telemetry-smoke.mjs",
    "start": "node --experimental-loader @opentelemetry/instrumentation/hook.mjs dist/index.js",
    "enqueue:demo": "tsx src/enqueue-demo.ts",
    "search:reindex": "tsx src/reindex-search.ts",
    "media:reprocess": "tsx src/reprocess-media.ts",
    "media:backfill-duplicates": "tsx src/backfill-duplicate-flags.ts",
    "media:identify": "tsx src/identify-image.ts",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/logger": "workspace:*",
    "@repo/telemetry": "workspace:*",
    "pino": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-proto": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "@opentelemetry/instrumentation-pg": "catalog:",
    "@opentelemetry/instrumentation-ioredis": "catalog:",
    "bullmq-otel": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@babel/runtime": "catalog:",
    "@repo/auth": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/google-places": "workspace:*",
    "@repo/queue": "workspace:*",
    "@repo/search": "workspace:*",
    "@repo/storage": "workspace:*",
    "bullmq": "catalog:",
    "dotenv": "^16.4.7",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "pg": "catalog:",
    "resend": "catalog:",
    "sharp": "catalog:",
    "typesense": "catalog:",
    "zod": "catalog:",
    "react-email": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@repo/billing": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "^9.18.0",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
