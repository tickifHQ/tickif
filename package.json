{
  "name": "tickif",
  "version": "0.0.0",
  "private": true,
  "description": "Tickif — discovery & portfolio platform for interior design projects in India",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "turbo run test --concurrency=2",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test --concurrency=2 -- --coverage",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:seed:demo": "pnpm --filter @repo/api seed:demo",
    "db:studio": "pnpm --filter @repo/db studio",
    "auth:generate": "pnpm --filter @repo/auth generate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  }
}
