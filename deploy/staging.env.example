# Public configuration only. Copy outside the repository, source with `set -a`.
STAGING_DOMAIN=staging.example.com
ACME_EMAIL=operations@example.com
EMAIL_FROM='Tickif Staging <staging@example.com>'
GOOGLE_CLIENT_ID=replace-with-staging-oauth-client-id
NOVU_OTP_WORKFLOW_ID=phone-otp
NOVU_BOOKING_WORKFLOW_ID=booking-requested
R2_ACCOUNT_ID=replace-with-32-character-cloudflare-account-id
R2_BUCKET=tickif-staging-media
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_PLAN_ID_PROFESSIONAL_PLUS=plan_replace
RAZORPAY_PLAN_ID_CORPORATE=plan_replace
# Use registry digest references from this release's image build output.
API_IMAGE=registry.example.com/tickif/api@sha256:replace
WEB_IMAGE=registry.example.com/tickif/web@sha256:replace
WORKER_IMAGE=registry.example.com/tickif/worker@sha256:replace
APP_SECRET=tickif_staging_app_v1
POSTGRES_SECRET=tickif_staging_postgres_v1
REDIS_SECRET=tickif_staging_redis_v1
TYPESENSE_SECRET=tickif_staging_typesense_v1
