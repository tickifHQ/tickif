# Save as a private file outside the repository; mount via Docker secret.
# Never source this file into the shell. dotenv parsing preserves quoted values.
POSTGRES_PASSWORD="replace-with-the-same-postgres-password-secret"
REDIS_URL="redis://:replace-with-url-encoded-redis-password@redis:6379/0"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-bytes"
TYPESENSE_API_KEY="replace-with-typesense-config-admin-key"
TYPESENSE_SEARCH_API_KEY="replace-with-distinct-search-only-key"
GOOGLE_CLIENT_SECRET="replace-with-staging-oauth-secret"
R2_ACCESS_KEY_ID="replace-with-staging-bucket-token-id"
R2_SECRET_ACCESS_KEY="replace-with-staging-bucket-token-secret"
RESEND_API_KEY="replace-with-resend-key"
NOVU_SECRET_KEY="replace-with-novu-key"
RAZORPAY_KEY_SECRET="replace-with-razorpay-test-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-test-webhook-secret"
