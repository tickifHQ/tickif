# ---------------------------------------------------------------------------
# Tickif environment variables
# Copy to `.env` and fill in. Loaded + validated by @repo/config (Zod).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Postgres (API/worker build DATABASE_URL from these; also read by docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tickif
POSTGRES_PASSWORD=tickif
POSTGRES_DB=tickif
# Integration tests use a separate `<POSTGRES_DB>_test` database, built automatically.
# Create it once: docker exec tickif-postgres createdb -U tickif tickif_test

# --- Redis (BullMQ + cache; REDIS_URL built from these) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- better-auth ---
# Generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3001

# --- Google / Gmail SSO (designers) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- API ---
PORT=3001
# Public base URL the web app uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- SMS / OTP provider (MSG91 — placeholder, stubbed in dev) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- Cloudflare R2 (media — placeholder for later phases) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
