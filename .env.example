# ---------------------------------------------------------------------------
# Tickif environment variables
# Copy to `.env` and fill in. Loaded + validated by @repo/config (Zod).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Postgres (API/worker build DATABASE_URL from these; also read by docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tickif
POSTGRES_PASSWORD=tickif
POSTGRES_DB=tickif
# Integration tests use a separate `<POSTGRES_DB>_test` database, built automatically.
# Create it once: docker exec tickif-postgres createdb -U tickif tickif_test

# --- Redis (BullMQ + cache; REDIS_URL built from these parts, matches docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Dedicated DB index for integration tests so destructive cleanup never touches dev data.
REDIS_URL_TEST=redis://localhost:6379/15

# --- better-auth ---
# Generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated trusted origins for cross-origin auth (web app calling API).
# Dev: the web app URL. Prod same-origin: leave empty.
TRUSTED_ORIGINS=http://localhost:3000

# --- Google / Gmail SSO (designers) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- API ---
PORT=3001
# Public base URL the web app uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Web (public feed scroll-gate) ---
# Cumulative downward scroll-units (400px each) before anon users hit the login wall.
# 0 disables the gate entirely. Default: 5.
NEXT_PUBLIC_SCROLL_GATE_LIMIT=5

# --- SMS / OTP provider ---
# Which provider delivers OTP SMS: console (dev log) | msg91. Prod fails closed if creds missing.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- Cloudflare R2 (media via S3 API; originals private) ---
# Endpoint defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
# Set R2_ENDPOINT to point at a local minio for tests/dev (e.g. http://localhost:9000).
# The bucket needs CORS allowing PUT from the web app origin — browsers upload directly.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tickif-media
# Presigned PUT lifetime in seconds (default 600).
R2_UPLOAD_URL_EXPIRY_SECONDS=600

# --- Media pipeline (E-107/108/110/112) ---
# Upload + decode limits. MEDIA_MAX_IMAGE_PIXELS is the decompression-bomb budget.
MEDIA_MAX_UPLOAD_BYTES=15000000
MEDIA_MAX_IMAGE_DIMENSION=12000
MEDIA_MAX_IMAGE_PIXELS=40000000
# Concurrent media jobs per worker (image work is CPU-heavy).
# Peak worker memory ≈ MEDIA_WORKER_CONCURRENCY × MEDIA_MAX_IMAGE_PIXELS × 4 bytes (decoded RGBA).
MEDIA_WORKER_CONCURRENCY=4
# Worker liveness/readiness HTTP port (/livez, /readyz).
WORKER_HEALTH_PORT=3002
# Watermark public derivatives only; originals stay clean.
WATERMARK_ENABLED=true
WATERMARK_TEXT=Tickif
WATERMARK_OPACITY=0.6
# Perceptual-hash dedup: near-duplicate if Hamming distance <= threshold. Action: reject | flag.
MEDIA_DEDUP_HAMMING_THRESHOLD=10
MEDIA_DEDUP_ACTION=reject
