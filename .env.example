# ---------------------------------------------------------------------------
# Tickif environment variables
# Copy to `.env` and fill in. Loaded + validated by @repo/config (Zod);
# NEXT_PUBLIC_* vars for the web app are validated by apps/web/src/env.ts.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Postgres (API/worker build DATABASE_URL from these; also read by docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tickif
POSTGRES_PASSWORD=tickif
POSTGRES_DB=tickif
# Integration tests use a separate `<POSTGRES_DB>_test` database, built automatically.
# Create it once: docker exec tickif-postgres createdb -U tickif tickif_test

# --- Redis (BullMQ + cache; REDIS_URL built from these parts, matches docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Dedicated DB index for integration tests so destructive cleanup never touches dev data.
REDIS_URL_TEST=redis://localhost:6379/15

# --- Typesense (Postgres remains the source of truth) ---
TYPESENSE_HOST=http://localhost:8108
# Admin bootstrap key. Use a unique secret in production.
TYPESENSE_API_KEY=tickif-local-typesense-key
# Search-only key used by query traffic. Local Docker accepts the shared dev key;
# production must use a separate key restricted to documents:search (docs/runbooks/search.md).
TYPESENSE_SEARCH_API_KEY=tickif-local-typesense-key
# Aliases are <prefix>_projects / <prefix>_designers; physical collections add a version suffix.
TYPESENSE_COLLECTION_PREFIX=tickif

# --- better-auth ---
# Generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3001

# Comma-separated trusted origins for cross-origin auth (web app calling API).
# Dev: the web app URL. Prod same-origin: leave empty.
TRUSTED_ORIGINS=http://localhost:3000

# --- Google / Gmail SSO (designers) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_PLACES_API_KEY=

# --- API ---
PORT=3001
# Public base URL the web app uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Web ---
# Public base URL used by browser code to build portfolio links.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Public base URL used when the API returns shareable portfolio links.
PUBLIC_WEB_URL=http://localhost:3000
# Pending ownership transfers expire after seven days by default.
OWNERSHIP_TRANSFER_EXPIRY_SECONDS=604800

# Public feed scroll-gate.
# Cumulative downward scroll-units (400px each) before anon users hit the login wall.
# 0 disables the gate entirely. Default: 5.
NEXT_PUBLIC_SCROLL_GATE_LIMIT=5

# --- Email provider ---
# Resend is required in production; development without a key logs email metadata only.
RESEND_API_KEY=
# Must be a sender/domain verified in the configured Resend account.
EMAIL_FROM="Tickif <noreply@tickif.com>"

# Temporary phone OTP email delivery for local/dev testing (requires Resend).
# Email mode is rejected in production and only delivers for the explicit E.164 allowlist.
PHONE_OTP_DELIVERY=sms
PHONE_OTP_EMAIL_TO=
PHONE_OTP_EMAIL_ALLOWED_NUMBERS=+919800000010
# Without Novu configured, set SMS_PROVIDER=console below; booking SMS will not be delivered.

# --- SMS provider ---
# Which provider delivers SMS: console (dev log) | novu. Prod fails closed if creds missing.
SMS_PROVIDER=novu
NOVU_SECRET_KEY=
NOVU_OTP_WORKFLOW_ID=phone-otp
NOVU_BOOKING_WORKFLOW_ID=booking-requested
NOVU_API_URL=https://api.novu.co

# --- Cloudflare R2 (media via S3 API; originals private) ---
# Endpoint defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
# Set R2_ENDPOINT to point at a local minio for tests/dev (e.g. http://localhost:9000).
# The bucket needs CORS allowing PUT from the web app origin — browsers upload directly.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tickif-media
# Presigned PUT lifetime in seconds (default 600).
R2_UPLOAD_URL_EXPIRY_SECONDS=600
ORGANIZATION_UPLOAD_SETTLE_SECONDS=300
# Presigned GET (download) lifetime in seconds (default 3600).
R2_DOWNLOAD_URL_EXPIRY_SECONDS=3600
# Private verification documents use a much shorter bearer-URL lifetime (default 60).
R2_VERIFICATION_DOWNLOAD_URL_EXPIRY_SECONDS=60

# --- Media pipeline (E-107/108/110/112) ---
# Upload + decode limits. MEDIA_MAX_IMAGE_PIXELS is the decompression-bomb budget.
MEDIA_MAX_UPLOAD_BYTES=15000000
MEDIA_MAX_IMAGE_DIMENSION=12000
MEDIA_MAX_IMAGE_PIXELS=40000000
# Concurrent media jobs per worker (image work is CPU-heavy).
# Peak worker memory ≈ MEDIA_WORKER_CONCURRENCY × MEDIA_MAX_IMAGE_PIXELS × 4 bytes (decoded RGBA).
MEDIA_WORKER_CONCURRENCY=4
# Concurrent Typesense indexing jobs per worker.
SEARCH_WORKER_CONCURRENCY=4
# Worker liveness/readiness HTTP port (/livez, /readyz).
WORKER_HEALTH_PORT=3002
# Watermark public derivatives only; originals stay clean.
WATERMARK_ENABLED=true
WATERMARK_TEXT=tickif
WATERMARK_OPACITY=0.22
WATERMARK_SCALE=0.16
WATERMARK_ROTATION=-30
# Bump when watermark settings change so immutable derivative caches are bypassed.
WATERMARK_REVISION=wm-v2
# Perceptual-hash dedup: near-duplicate if Hamming distance <= threshold. Action: reject | flag.
MEDIA_DEDUP_HAMMING_THRESHOLD=10
MEDIA_DEDUP_ACTION=reject

# --- Razorpay Billing (E-115) ---
# Key prefix determines mode: rzp_test_* = Test Mode, rzp_live_* = Live.
# Optional in dev/test — subscribe endpoints fail fast when missing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Plan IDs created in the Razorpay dashboard (or via API). One per paid tier.
RAZORPAY_PLAN_ID_PROFESSIONAL_PLUS=
RAZORPAY_PLAN_ID_CORPORATE=
# Webhook secret for signature verification (E-117).
RAZORPAY_WEBHOOK_SECRET=

# Plan-lapse lifecycle windows (E-239). Days in grace before lock, and days
# locked before downgrade. Sweep cadence in ms. Locked window is provisional (E-255).
BILLING_GRACE_PERIOD_DAYS=7
BILLING_LOCKED_PERIOD_DAYS=30
BILLING_LIFECYCLE_SWEEP_INTERVAL_MS=3600000
ORGANIZATION_DELIST_RETENTION_DAYS=90
ORGANIZATION_ARCHIVE_RETENTION_DAYS=365
