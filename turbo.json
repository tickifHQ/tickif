{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "CONFIG_SECRETS_FILE",
    "DATABASE_URL",
    "REDIS_URL",
    "TYPESENSE_HOST",
    "TYPESENSE_API_KEY",
    "TYPESENSE_SEARCH_API_KEY",
    "TYPESENSE_COLLECTION_PREFIX",
    "SEARCH_WORKER_CONCURRENCY",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_PLACES_API_KEY",
    "GOOGLE_PLACES_REFRESH_DAYS",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WEB_URL",
    "NEXT_PUBLIC_SCROLL_GATE_LIMIT",
    "NOVU_BOOKING_WORKFLOW_ID",
    "DATABASE_URL_TEST",
    "REDIS_URL_TEST"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "generate": {
      "cache": false
    },
    "migrate": {
      "cache": false
    }
  }
}
