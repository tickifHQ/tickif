api:
  dashboard: false
  insecure: false

ping:
  entryPoint: ping

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt
  ping:
    address: ":8082"

providers:
  swarm:
    endpoint: http://socket-proxy:2375
    exposedByDefault: false
    network: tickif_edge
    watch: true
  file:
    filename: /etc/traefik/dynamic.yml
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: ${LETSENCRYPT_EMAIL}
      caServer: ${ACME_CA_SERVER}
      storage: /letsencrypt/acme.json
      httpChallenge:
        entryPoint: web

log:
  level: INFO
  format: json

accessLog:
  format: json
  fields:
    defaultMode: keep
    names:
      ClientUsername: drop
    headers:
      defaultMode: drop
      names:
        User-Agent: keep
        Referer: keep
        Authorization: redact
        Cookie: redact
        Set-Cookie: redact
        X-Api-Key: redact
        X-Forwarded-For: redact
