# Release/backup utility image. It intentionally contains migration and CLI
# tooling; long-running application images remain production-dependency-only.
FROM node:22-bookworm-slim AS node-runtime

# Base the final image on the same Postgres major as the stack. pg_dump refuses
# to back up a newer server major, while the Node runtime is needed for Drizzle,
# seed, and Typesense release tasks.
FROM postgres:16-bookworm
COPY --from=node-runtime /usr/local/ /usr/local/
WORKDIR /app
ENV COREPACK_HOME=/opt/corepack
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl age rclone \
  && rm -rf /var/lib/apt/lists/* \
  && rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg \
  && corepack enable && corepack prepare pnpm@10.33.0 --activate \
  && useradd --create-home --uid 1001 app
COPY --chown=app:app . .
RUN pnpm install --frozen-lockfile && pnpm store prune
USER app
ENTRYPOINT ["bash"]
