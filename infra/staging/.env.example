# Non-secret deployment inputs. Copy to /opt/tickif/staging.env on the manager
# and protect it with chmod 600. Secret values live in versioned Swarm secrets.
STACK_NAME=tickif
STAGING_HOST=staging.tickif.com
LETSENCRYPT_EMAIL=ops@tickif.example

# Immutable application images. A SHA tag is acceptable; a registry digest is preferred.
API_IMAGE=ghcr.io/example/tickif-api:0123456789abcdef0123456789abcdef01234567
WEB_IMAGE=ghcr.io/example/tickif-web:0123456789abcdef0123456789abcdef01234567
WORKER_IMAGE=ghcr.io/example/tickif-worker:0123456789abcdef0123456789abcdef01234567
OPERATIONS_IMAGE=ghcr.io/example/tickif-operations:0123456789abcdef0123456789abcdef01234567

POSTGRES_USER=tickif
POSTGRES_DB=tickif
TYPESENSE_COLLECTION_PREFIX=tickif_staging
R2_ENDPOINT=https://00000000000000000000000000000000.r2.cloudflarestorage.com
R2_BUCKET=tickif-staging-media
BACKUP_R2_BUCKET=tickif-staging-backups
EMAIL_FROM="Tickif Staging <staging@tickif.example>"
SMS_PROVIDER=novu
NOVU_OTP_WORKFLOW_ID=phone-otp
NOVU_BOOKING_WORKFLOW_ID=booking-requested
NOVU_API_URL=https://api.novu.co

# External, immutable Swarm secret object names. Rotate by creating a new
# version, changing the reference, deploying, and removing the old version.
POSTGRES_PASSWORD_SECRET=tickif_staging_postgres_password_v1
REDIS_PASSWORD_SECRET=tickif_staging_redis_password_v1
TYPESENSE_ADMIN_KEY_SECRET=tickif_staging_typesense_admin_key_v1
TYPESENSE_SEARCH_KEY_SECRET=tickif_staging_typesense_search_key_v1
BETTER_AUTH_SECRET_NAME=tickif_staging_better_auth_secret_v1
NOVU_SECRET_NAME=tickif_staging_novu_secret_v1
R2_ACCESS_KEY_ID_SECRET=tickif_staging_r2_access_key_id_v1
R2_SECRET_ACCESS_KEY_SECRET=tickif_staging_r2_secret_access_key_v1
RESEND_API_KEY_SECRET=tickif_staging_resend_api_key_v1
# Restore only: an age private identity, never the former CBC passphrase.
BACKUP_ENCRYPTION_KEY_SECRET=tickif_staging_backup_age_identity_v1

# Set by deploy.sh after it creates content-addressed Swarm configs.
TRAEFIK_STATIC_CONFIG=tickif_staging_traefik_static_bootstrap
TRAEFIK_DYNAMIC_CONFIG=tickif_staging_traefik_dynamic_bootstrap

# Manifests fail closed. deploy.sh starts desired counts only after preparation.
WEB_REPLICAS=0
API_REPLICAS=0
WORKER_REPLICAS=0

TRAEFIK_REPLICAS=0
DESIRED_WEB_REPLICAS=2
DESIRED_API_REPLICAS=2
DESIRED_WORKER_REPLICAS=1
GOOGLE_CLIENT_ID=configure-staging-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_NAME=tickif_staging_google_client_secret_v1
RAZORPAY_KEY_ID=rzp_test_configure_staging
RAZORPAY_KEY_SECRET_NAME=tickif_staging_razorpay_key_secret_v1
RAZORPAY_WEBHOOK_SECRET_NAME=tickif_staging_razorpay_webhook_secret_v1
# age public recipient; private identity is kept offline until a restore drill.
BACKUP_AGE_RECIPIENT=age1_replace_with_age_keygen_public_key
