{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./email": {
      "types": "./src/email.ts",
      "default": "./src/email.ts"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "default": "./src/permissions.ts"
    },
    "./email-templates": {
      "types": "./src/email-templates.ts",
      "default": "./src/email-templates.ts"
    }
  },
  "scripts": {
    "emails:preview": "tsx scripts/preview-emails.ts --serve",
    "emails:export": "tsx scripts/preview-emails.ts",
    "generate": "npx --yes @better-auth/cli@latest generate --config ./src/index.ts --output ./auth-schema.generated.ts",
    "lint": "eslint src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/queue": "workspace:*",
    "better-auth": "catalog:",
    "resend": "catalog:",
    "react-email": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "^9.18.0",
    "typescript": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "@types/react": "catalog:"
  }
}
