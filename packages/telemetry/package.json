{
  "name": "@repo/telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/node.ts", "default": "./src/node.ts" },
    "./node": { "types": "./src/node.ts", "default": "./src/node.ts" }
  },
  "scripts": {
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
